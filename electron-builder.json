{
  "appId": "com.petfresh.labelprinter",
  "productName": "Pet Fresh Label Printer",
  "copyright": "Copyright © 2025 Pet Fresh",
  "directories": {
    "output": "dist"
  },
  "asar": false,
  "files": [
    "src/**/*",
    "public/**/*",
    "electron/**/*",
    "node_modules/**/*",
    "package.json",
    "!src/tools/**/*",
    "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,suo,xproj,cc,d.ts,pdb}"
  ],
  "win": {
    "icon": "public/assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "signAndEditExecutable": false,
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Pet Fresh Label Printer",
    "installerIcon": "public/assets/icon.ico",
    "uninstallerIcon": "public/assets/icon.ico",
    "deleteAppDataOnUninstall": true,
    "menuCategory": "Pet Fresh",
    "warningsAsErrors": false
  },
  "publish": null,
  "nodeGypRebuild": false,
  "npmRebuild": false,
  "buildDependenciesFromSource": false
} 